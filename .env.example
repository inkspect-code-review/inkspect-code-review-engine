# Compose path settings. Keep real credentials in your shell/secret manager.
INKSPECT_REPO_PATH=.
INKSPECT_CONFIG=./.local/host.json
INKSPECT_JOB=./.local/job.json
INKSPECT_UID=1000
INKSPECT_GID=1000
AWS_REGION=eu-west-2
QDRANT_PORT=6333
